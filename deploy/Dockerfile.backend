# Backend Dockerfile - Multi-stage build
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY api-admin/pom.xml api-admin/
COPY core-domain/pom.xml core-domain/
COPY core-infrastructure/pom.xml core-infrastructure/
COPY core-application/pom.xml core-application/
COPY api-client/pom.xml api-client/
RUN mvn dependency:go-offline -B
COPY . .
RUN mvn package -pl api-admin -am -DskipTests -B

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=build /app/api-admin/target/api-admin-*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-XX:+UseG1GC", "-Xms256m", "-Xmx512m", "-jar", "app.jar"]
